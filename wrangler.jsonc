{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bienen-doku-pflicht",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "send_metrics": false,
  "workers_dev": true,
  "preview_urls": false,
  "r2_buckets": [
    {
      "binding": "SYNC_BUCKET",
      "bucket_name": "bienen-doku-pflicht-sync",
      "jurisdiction": "eu"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.05
  },
  "env": {
    "production": {
      "name": "bienen-doku-pflicht",
      "workers_dev": true,
      "preview_urls": false,
      "r2_buckets": [
        {
          "binding": "SYNC_BUCKET",
          "bucket_name": "bienen-doku-pflicht-sync",
          "jurisdiction": "eu"
        }
      ]
    }
  }
}
